#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v docker >/dev/null 2>&1; then
  echo "rin local ci: docker is required for the complete pre-push gate." >&2
  exit 1
fi

tree_id="$(git write-tree)"
image_tag="rin-local-ci:staged-${tree_id}"
archive_file="$(mktemp)"
cleanup() {
  rm -f "$archive_file"
}
trap cleanup EXIT
git archive --format=tar --mtime=1970-01-01T00:00:00Z \
  "$tree_id" >"$archive_file"

echo "rin local ci: building container image from staged tree..."
scripts/test/build-test-image.sh "$archive_file" "$image_tag"
image_id="$(docker image inspect --format '{{.Id}}' "$image_tag")"

echo "rin local ci: running the complete pre-push gate..."
docker run --rm --network none --memory 4g --memory-swap 4g "$image_id"
