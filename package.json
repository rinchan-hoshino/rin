{
  "name": "@hoshinorin/rin",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rinchan-hoshino/rin.git"
  },
  "bin": {
    "rin": "dist/app/rin/main.js",
    "rin-daemon": "dist/app/rin-daemon/daemon.js",
    "rin-install": "dist/app/rin-install/main.js"
  },
  "scripts": {
    "build:core": "rm -rf dist && tsc -p tsconfig.json --pretty false",
    "build": "npm run build:core && chmod +x dist/app/rin/main.js dist/app/rin-daemon/daemon.js dist/app/rin-daemon/worker.js dist/app/rin-tui/main.js dist/app/rin-install/main.js",
    "format": "tsx scripts/run-format-check.ts --write",
    "format:check": "tsx scripts/run-format-check.ts --check",
    "sync:upstreams": "tsx scripts/sync-upstreams.ts",
    "sync:pi-docs": "tsx scripts/sync-upstreams.ts pi",
    "sync:skill-creator": "tsx scripts/sync-upstreams.ts skill-creator",
    "sync:prompt-engineer": "tsx scripts/sync-upstreams.ts prompt-engineer",
    "release:manifest": "tsx scripts/release/update-release-manifest.ts",
    "release:changelog": "tsx scripts/release/verify-changelog.ts",
    "release:bootstrap": "tsx scripts/release/export-bootstrap-branch.ts",
    "prepare": "tsx scripts/install-git-hooks.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:release": "node --import tsx --test --test-concurrency=4 tests/unit/installer-modules.test.ts tests/unit/rin-cli.test.ts tests/unit/rpc-and-shared.test.ts tests/e2e/bootstrap-entrypoint.test.ts tests/e2e/install-to-tui-user-flow.test.ts tests/unit/release.test.ts tests/e2e/release-scripts.test.ts",
    "test:unit": "npm run build && node --import tsx --test --test-concurrency=4 $(find tests/unit -name '*.test.ts' -print | sort)",
    "test:e2e": "npm run build && node --import tsx --test --test-concurrency=2 $(find tests/e2e -name '*.test.ts' -print | sort)",
    "test:interactive": "npm run build && node --import tsx --test --test-concurrency=2 $(find tests/interactive -name '*.test.ts' -print | sort)",
    "test:manual:install-tui": "npm run build && node --import tsx tests/interactive/install-to-tui-manual.ts",
    "test:manual:install-tui:scripted": "npm run build && node --import tsx tests/interactive/install-to-tui-manual.ts --scripted",
    "lint": "NODE_OPTIONS=--import=tsx eslint . --ext .ts --max-warnings 0",
    "lint:fix": "NODE_OPTIONS=--import=tsx eslint . --ext .ts --fix"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "@earendil-works/pi-agent-core": "^0.79.7",
    "@earendil-works/pi-ai": "^0.79.7",
    "@earendil-works/pi-coding-agent": "^0.79.7",
    "@earendil-works/pi-tui": "^0.79.7",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@mozilla/readability": "^0.6.0",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "@slack/socket-mode": "^2.0.6",
    "@slack/web-api": "^7.15.1",
    "@types/jsdom": "^28.0.1",
    "@types/turndown": "^5.0.6",
    "better-sqlite3": "^12.8.0",
    "cac": "^6.7.14",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "diff": "^8.0.4",
    "discord.js": "^14.26.3",
    "electron": "^41.3.0",
    "extract-zip": "^2.0.1",
    "file-type": "^21.3.4",
    "glob": "^13.0.6",
    "hosted-git-info": "^9.0.2",
    "ignore": "^7.0.5",
    "jsdom": "^29.1.1",
    "marked": "^15.0.12",
    "minimatch": "^10.2.4",
    "pretty-ms": "^9.3.0",
    "proper-lockfile": "^4.1.2",
    "qq-guild-bot": "^2.9.5",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.4",
    "typebox": "^1.1.32",
    "undici": "^7.24.6",
    "ws": "^8.18.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/hosted-git-info": "^3.0.5",
    "@types/node": "^22.13.10",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^9.24.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/THE_cattail"
  }
}
