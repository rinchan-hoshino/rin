{
  "name": "@hoshinorin/rin",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rinchan-hoshino/rin.git"
  },
  "bin": {
    "rin": "dist/app/rin/main.js",
    "rin-daemon": "dist/app/rin-daemon/daemon.js",
    "rin-install": "dist/app/rin-install/main.js"
  },
  "exports": {
    "./extension": {
      "types": "./src/core/rin-extension-api.ts",
      "import": "./dist/core/rin-extension-api.js"
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "tsx scripts/run-format-check.ts --write",
    "format:check": "tsx scripts/run-format-check.ts --check",
    "sync:upstreams": "tsx scripts/sync-upstreams.ts",
    "sync:pi-docs": "tsx scripts/sync-upstreams.ts pi",
    "sync:skill-creator": "tsx scripts/sync-upstreams.ts skill-creator",
    "release:manifest": "tsx scripts/release/update-release-manifest.ts",
    "release:local": "tsx scripts/release/publish-local.ts",
    "release:changelog": "tsx scripts/release/verify-changelog.ts",
    "release:bootstrap": "tsx scripts/release/export-bootstrap-branch.ts",
    "release:bundle": "tsx scripts/release/build-platform-bundle.ts",
    "prepare": "tsx scripts/install-git-hooks.ts",
    "test": "npm run test:container",
    "test:types": "npm run test:container -- --suite types",
    "test:release": "npm run test:container -- --suite release",
    "test:unit": "npm run test:container -- --suite unit",
    "test:manual:install-tui": "npm run test:container -- --manual-install-tui",
    "test:manual:install-tui:scripted": "npm run test:container -- --manual-install-tui --scripted",
    "lint": "NODE_OPTIONS=--import=tsx eslint . --ext .ts --max-warnings 0",
    "lint:fix": "NODE_OPTIONS=--import=tsx eslint . --ext .ts --fix",
    "test:container": "bash scripts/test/run-containerized.sh",
    "test:inner": "npm run test:current:run",
    "test:current:run": "tsx scripts/test/run-commit-tests.ts",
    "test:release:run": "tsx scripts/test/run-test-files.ts --concurrency=4 tests/integration/installer-modules.test.ts tests/integration/rin-cli.test.ts tests/integration/rpc-and-shared-owner.test.ts tests/integration/bootstrap-entrypoint.test.ts tests/system/install-to-tui-user-flow.test.ts tests/integration/rin-release-owner.test.ts tests/integration/rin-shared-owner.test.ts tests/integration/release-scripts.test.ts",
    "test:architecture": "npm run test:container -- --suite architecture",
    "test:architecture:run": "tsx scripts/test/run-test-suite.ts architecture",
    "test:unit:run": "tsx scripts/test/run-test-suite.ts unit",
    "test:unit:coverage": "npm run test:container -- --suite unit:coverage",
    "test:unit:coverage:run": "tsx scripts/test/run-coverage.ts --unit",
    "test:acceptance": "npm run test:container -- --suite acceptance",
    "test:acceptance:run": "tsx scripts/test/run-test-suite.ts acceptance",
    "test:property": "npm run test:container -- --suite property",
    "test:property:run": "tsx scripts/test/run-test-suite.ts property",
    "test:mutation": "npm run test:container -- --suite mutation",
    "test:mutation:run": "tsx scripts/test/run-mutation.ts",
    "test:qa": "npm run test:container -- --suite qa",
    "test:qa:run": "tsx scripts/test/run-test-suite.ts qa",
    "test:torture": "npm run test:container -- --suite torture",
    "test:torture:run": "tsx scripts/test/run-test-suite.ts torture",
    "test:regression": "npm run test:container -- --suite regression",
    "test:regression:run": "tsx scripts/test/run-test-suite.ts regression",
    "test:integration": "npm run test:container -- --suite integration",
    "test:integration:run": "tsx scripts/test/run-test-suite.ts integration",
    "test:system": "npm run test:container -- --suite system",
    "test:system:run": "tsx scripts/test/run-test-suite.ts system",
    "test:coverage": "npm run test:container -- --suite coverage",
    "test:coverage:run": "tsx scripts/test/run-coverage.ts",
    "test:types:run": "tsc -p tests/typecheck/tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "better-sqlite3": "^12.11.1",
    "cac": "^6.7.14",
    "chalk": "^5.6.2",
    "croner": "^10.0.1",
    "diff": "^8.0.4",
    "discord.js": "^14.26.3",
    "grammy": "^1.44.0",
    "kerium": "^1.3.9",
    "marked": "^15.0.12",
    "proper-lockfile": "^4.1.2",
    "strip-ansi": "^7.2.0",
    "typebox": "^1.1.32",
    "undici": "^7.29.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@eslint/js": "^9.24.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/proper-lockfile": "^4.1.4",
    "@xterm/headless": "^5.5.0",
    "c8": "^10.1.3",
    "eslint": "^9.24.0",
    "fast-check": "4.9.0",
    "jiti": "2.7.0",
    "prettier": "^3.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/THE_cattail"
  },
  "overrides": {
    "axios": "^1.18.0",
    "esbuild": "^0.28.1",
    "discord.js": {
      "undici": "6.28.0"
    },
    "@discordjs/rest": {
      "undici": "6.28.0"
    }
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.4": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
