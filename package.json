{
  "name": "@rinchanai20260422/rin",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rinchanai/rin.git"
  },
  "bin": {
    "rin": "dist/app/rin/main.js",
    "rin-daemon": "dist/app/rin-daemon/daemon.js",
    "rin-tui": "dist/app/rin-tui/main.js",
    "rin-gui": "dist/app/rin-gui/main.js",
    "rin-install": "dist/app/rin-install/main.js",
    "rin-desktop-host": "dist/app/rin-desktop-host/main.js"
  },
  "scripts": {
    "build:core": "rm -rf dist && tsc -p tsconfig.json --pretty false",
    "build": "npm run build:core && chmod +x dist/app/rin/main.js dist/app/rin-daemon/daemon.js dist/app/rin-daemon/worker.js dist/app/rin-tui/main.js dist/app/rin-gui/main.js dist/app/rin-desktop-host/main.js dist/app/rin-install/main.js",
    "format": "node scripts/run-format-check.mjs --write",
    "format:check": "node scripts/run-format-check.mjs --check",
    "sync:upstreams": "node scripts/sync-upstreams.mjs",
    "sync:pi-docs": "node scripts/sync-upstreams.mjs pi",
    "sync:skill-creator": "node scripts/sync-upstreams.mjs skill-creator",
    "release:manifest": "node scripts/release/update-release-manifest.mjs",
    "release:changelog": "node scripts/release/verify-changelog.mjs",
    "release:bootstrap": "node scripts/release/export-bootstrap-branch.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:release": "node --import tsx --test tests/unit/installer-modules.test.ts tests/unit/rin-cli.test.ts tests/unit/rpc-and-shared.test.ts tests/e2e/bootstrap-entrypoint.test.ts tests/e2e/install-to-tui-user-flow.test.ts tests/unit/release.test.ts tests/e2e/release-scripts.test.ts",
    "test:unit": "npm run build && node --import tsx --test $(find tests/unit -name '*.test.ts' -print | sort)",
    "test:e2e": "npm run build && node --import tsx --test $(find tests/e2e -name '*.test.ts' -print | sort)",
    "test:interactive": "npm run build && node --import tsx --test $(find tests/interactive -name '*.test.ts' -print | sort)",
    "test:manual:install-tui": "npm run build && node --import tsx tests/interactive/install-to-tui-manual.ts",
    "test:manual:install-tui:scripted": "npm run build && node --import tsx tests/interactive/install-to-tui-manual.ts --scripted",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@mariozechner/pi-agent-core": "^0.72.1",
    "@mariozechner/pi-ai": "^0.72.1",
    "@mariozechner/pi-coding-agent": "^0.72.1",
    "@mariozechner/pi-tui": "^0.72.1",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "@slack/socket-mode": "^2.0.6",
    "@slack/web-api": "^7.15.1",
    "better-sqlite3": "^12.8.0",
    "cac": "^6.7.14",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "diff": "^8.0.4",
    "discord.js": "^14.26.3",
    "electron": "^41.3.0",
    "extract-zip": "^2.0.1",
    "file-type": "^21.3.4",
    "glob": "^13.0.6",
    "hosted-git-info": "^9.0.2",
    "ignore": "^7.0.5",
    "marked": "^15.0.12",
    "minimatch": "^10.2.4",
    "pretty-ms": "^9.3.0",
    "proper-lockfile": "^4.1.2",
    "qq-guild-bot": "^2.9.5",
    "strip-ansi": "^7.2.0",
    "typebox": "^1.1.32",
    "undici": "^7.24.6",
    "ws": "^8.18.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/hosted-git-info": "^3.0.5",
    "@types/node": "^22.13.10",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^9.24.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.1"
  }
}
