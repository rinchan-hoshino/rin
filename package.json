{
  "name": "@hoshinorin/rin",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rinchan-hoshino/rin.git"
  },
  "bin": {
    "rin": "dist/app/rin/main.js",
    "rin-daemon": "dist/app/rin-daemon/daemon.js",
    "rin-install": "dist/app/rin-install/main.js"
  },
  "scripts": {
    "build:core": "tsx scripts/build.ts --core",
    "build": "tsx scripts/build.ts",
    "format": "tsx scripts/run-format-check.ts --write",
    "format:check": "tsx scripts/run-format-check.ts --check",
    "sync:upstreams": "tsx scripts/sync-upstreams.ts",
    "sync:pi-docs": "tsx scripts/sync-upstreams.ts pi",
    "sync:skill-creator": "tsx scripts/sync-upstreams.ts skill-creator",
    "release:manifest": "tsx scripts/release/update-release-manifest.ts",
    "release:changelog": "tsx scripts/release/verify-changelog.ts",
    "release:bootstrap": "tsx scripts/release/export-bootstrap-branch.ts",
    "release:bundle": "tsx scripts/release/build-platform-bundle.ts",
    "prepare": "tsx scripts/install-git-hooks.ts",
    "test": "npm run build && npm run test:coverage:run",
    "test:release": "npm run build && npm run test:release:run",
    "test:release:run": "tsx scripts/test/run-test-files.ts --concurrency=4 tests/characterization/installer-modules.test.ts tests/integration/rin-cli.test.ts tests/characterization/rpc-and-shared.test.ts tests/integration/bootstrap-entrypoint.test.ts tests/system/install-to-tui-user-flow.test.ts tests/characterization/release.test.ts tests/integration/release-scripts.test.ts",
    "test:architecture": "npm run build && npm run test:architecture:run",
    "test:architecture:run": "tsx scripts/test/run-test-suite.ts architecture",
    "test:unit": "npm run build && npm run test:unit:run",
    "test:unit:run": "tsx scripts/test/run-test-suite.ts unit",
    "test:unit:coverage": "npm run build && npm run test:unit:coverage:run",
    "test:unit:coverage:run": "tsx scripts/test/run-coverage.ts --unit",
    "test:regression": "npm run build && npm run test:regression:run",
    "test:regression:run": "tsx scripts/test/run-test-suite.ts regression",
    "test:characterization": "npm run build && npm run test:characterization:run",
    "test:characterization:run": "tsx scripts/test/run-test-suite.ts characterization",
    "test:integration": "npm run build && npm run test:integration:run",
    "test:integration:run": "tsx scripts/test/run-test-suite.ts integration",
    "test:system": "npm run build && npm run test:system:run",
    "test:system:run": "tsx scripts/test/run-test-suite.ts system",
    "test:coverage": "npm run build && npm run test:coverage:run",
    "test:coverage:run": "tsx scripts/test/run-coverage.ts",
    "test:manual:install-tui": "npm run build && node --import tsx tests/system/install-to-tui-manual.ts",
    "test:manual:install-tui:scripted": "npm run build && node --import tsx tests/system/install-to-tui-manual.ts --scripted",
    "lint": "NODE_OPTIONS=--import=tsx eslint . --ext .ts --max-warnings 0",
    "lint:fix": "NODE_OPTIONS=--import=tsx eslint . --ext .ts --fix"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "@earendil-works/pi-agent-core": "^0.80.10",
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "@mozilla/readability": "^0.6.0",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "@slack/socket-mode": "^2.0.6",
    "@slack/web-api": "^7.15.1",
    "better-sqlite3": "^12.11.1",
    "cac": "^6.7.14",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "diff": "^8.0.4",
    "discord.js": "^14.26.3",
    "extract-zip": "^2.0.1",
    "file-type": "^21.3.4",
    "glob": "^13.0.6",
    "grammy": "^1.44.0",
    "hosted-git-info": "^9.0.2",
    "ignore": "^7.0.5",
    "jsdom": "^29.1.1",
    "kerium": "^1.3.9",
    "marked": "^15.0.12",
    "minimatch": "^10.2.4",
    "pretty-ms": "^9.3.0",
    "proper-lockfile": "^4.1.2",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.4",
    "typebox": "^1.1.32",
    "undici": "^7.28.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/hosted-git-info": "^3.0.5",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.13.10",
    "@types/proper-lockfile": "^4.1.4",
    "@types/turndown": "^5.0.6",
    "c8": "^10.1.3",
    "electron": "^41.3.0",
    "eslint": "^9.24.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/THE_cattail"
  },
  "overrides": {
    "axios": "^1.18.0",
    "esbuild": "^0.28.1",
    "discord.js": {
      "undici": "6.27.0"
    },
    "@discordjs/rest": {
      "undici": "6.27.0"
    }
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.4": true,
    "better-sqlite3@12.11.1": true,
    "electron@41.3.0": true,
    "esbuild@0.28.1": true
  }
}
